[Unit]
Description=FRP client for outbound relay tunnel (STCP)
After=network-online.target frps.service postfix.service
Wants=network-online.target
Requires=frps.service

[Service]
Type=simple
ExecStart=/usr/local/bin/frpc -c /etc/frp/frpc-relay.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
