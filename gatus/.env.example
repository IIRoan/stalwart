# Solace Gatus on Railway — set these in the Railway service dashboard.
# Create a new Railway service with root directory `gatus` and attach a volume at /data.

PORT=8080
GATUS_CONFIG_PATH=/data/config.yaml

# --- Mail slot detail (optional) ---
# Enables the slot-blue-green monitor (GET /slot-manager/status).
# Use the same value as the Stalwart mail service.
SLOT_MANAGER_TOKEN=

# --- Status page auth (optional) ---
# GATUS_ADMIN_USERNAME=admin
# GATUS_ADMIN_PASSWORD=

# --- Alerting (optional) ---
# SLACK_WEBHOOK_URL=

# --- Full config override (optional) ---
# GATUS_CONFIG_YAML=

# --- VPS internal checks via SSH (optional, separate from public mail probes) ---
# 1. sudo install -m 0755 vps/gatus-monitor.sh /usr/local/bin/gatus-monitor.sh
# 2. Create gatus-monitor user with restricted authorized_keys (see gatus/README.md)
# 3. Set:
# VPS_MONITOR_SSH_USERNAME=gatus-monitor
# VPS_MONITOR_SSH_PRIVATE_KEY_B64=<base64 of private key>
# VPS_MONITOR_SSH_HOST=mail.solace.onl
# VPS_MONITOR_SSH_PORT=22
