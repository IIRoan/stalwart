# Solace Gatus on Railway — set these in the Railway service dashboard.
# Create a new Railway service with root directory `gatus` and attach a volume at /data.

PORT=8080
GATUS_CONFIG_PATH=/data/config.yaml

# Same token Stalwart uses for slot-manager /status (Railway → VPS).
SLOT_MANAGER_TOKEN=

# Optional: lock the status page behind HTTP basic auth.
# GATUS_ADMIN_USERNAME=admin
# GATUS_ADMIN_PASSWORD=

# Optional: Slack alerts (uncomment alerting block in config.default.yaml too).
# SLACK_WEBHOOK_URL=

# Optional: full YAML override (replaces baked-in config on every boot).
# GATUS_CONFIG_YAML=

# Optional: VPS internal health via SSH (install vps/gatus-monitor.sh first).
# VPS_MONITOR_SSH_USERNAME=gatus-monitor
# VPS_MONITOR_SSH_HOST=mail.solace.onl
# VPS_MONITOR_SSH_PORT=22
# VPS_MONITOR_SSH_PRIVATE_KEY_B64=
# VPS_MONITOR_SSH_COMMAND=/usr/local/bin/gatus-monitor.sh
